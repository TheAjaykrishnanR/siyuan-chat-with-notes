{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "paths": {
      "siyuan": ["./siyuan-plugin-api-reference/siyuan.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.svelte", "siyuan-plugin-api-reference/siyuan.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
